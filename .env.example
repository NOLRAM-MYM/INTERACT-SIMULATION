# =============================================================================
# .env.example — Copy to .env and fill in your values.
# Never commit the real .env file to version control.
# =============================================================================

# --- Django Core ---
SECRET_KEY=your-very-secret-django-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (default: SQLite for dev; switch to PostgreSQL for production) ---
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:password@localhost:5432/sci_dashboard

# --- Redis (for Celery task queue) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (Vite dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- CSRF (production only; defaults to https:// + each ALLOWED_HOSTS entry) ---
# CSRF_TRUSTED_ORIGINS=https://dashboard.example.com

# --- Vite ---
# Set this and run `npm run dev` alongside runserver for hot reload. Left unset,
# the templates read the built manifest, so a plain runserver needs `npm run
# build` first. In production the order is `npm run build` THEN `collectstatic`.
# VITE_DEV_SERVER_URL=http://localhost:5173

# Note: STATIC_URL and STATIC_ROOT are set in config/settings/base.py and are
# not read from the environment — putting them here would have no effect.
